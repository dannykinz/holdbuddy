---
import './comeback.css';
---

<!-- Comeback Section -->
<section id="built_differently" class="comeback_section" aria-labelledby="comeback_title">
  <div class="comeback_contents" data-reveal>
    <p class="eyebrow">Built differently</p>
    <h2 id="comeback_title">Built for the day you miss.</h2>
    <p class="comeback_description">
      Most study apps punish a broken streak, so one bad week becomes the reason you quit. Holdbuddy
      moves your finish date, keeps your progress, and gets you back to the next chapter.
    </p>
    <a class="text_link" href="#how_it_works">
      See how it works
      <img
        src="/images/arrow-dark.svg"
        width="18"
        height="18"
        alt="Explore how Holdbuddy works"
        aria-hidden="true"
      />
    </a>
  </div>
  <img
    class="comeback_preview"
    src="/images/comeback-preview.png"
    width="620"
    height="600"
    alt="Welcome back screen showing Danny's recalculated finish date, a kind message to Elvis, and no lost streak"
    loading="lazy"
    decoding="async"
    data-reveal
  />
</section>
