---
import DocumentLayout from '../layouts/DocumentLayout.astro';
import PageHeader from '../components/page_header/PageHeader.astro';
import LegalDocument from '../components/legal_document/LegalDocument.astro';
import { privacyPolicy } from '../data/legal';
import { siteConfig } from '../config/site';
---

<DocumentLayout title={privacyPolicy.title} description={privacyPolicy.description}>
  <PageHeader label="Legal" title={privacyPolicy.title} updatedDate={siteConfig.updatedDate} />
  <LegalDocument document={privacyPolicy} />
</DocumentLayout>
